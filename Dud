RunService.Heartbeat:Connect(function()
    if not State.VoidHide then
        return
    end

    if not State.VoidStayFloating then
        return
    end

    if not Runtime.VoidHidePosition then
        return
    end

    pcall(function()
        local root = getRoot()
        if not root then
            return
        end

        local target =
            Runtime.VoidHidePosition

        if (
            root.Position -
            target
        ).Magnitude > 5 then

            teleport(target)

        elseif State.ResetVelocity then
            root.AssemblyLinearVelocity =
                Vector3.zero

            root.AssemblyAngularVelocity =
                Vector3.zero
        end
    end)
end)

