local function loadConfig(name)
    name = tostring(
        name or State.ConfigName
    )

    local data =
        Runtime.Configs[name]

    if not data then
        return false
    end

    local oldVoidHide =
        State.VoidHide

    if oldVoidHide then
        State.VoidHide = false
        exitVoidHide()
    end

    for key, value in pairs(data) do
        if State[key] ~= nil then
            State[key] = value
        end
    end

    State.ConfigName = name

    Runtime.VoidAxisIndex = 1
    Runtime.FrameCounter = 0
    Runtime.FrameSequence = 0
    Runtime.FrameBurstCounter = 0
    Runtime.FramePatternIndex = 0
    Runtime.OrbitAngle = 0
    Runtime.CycloneAngle = 0
    Runtime.UnpredictableSequence = 0
    Runtime.LastTeleport = 0
    Runtime.LastDestination = nil
    Runtime.LastPosition = nil
    Runtime.LastDirection = nil
    Runtime.LastFramePosition = nil

    syncUI()

    if State.VoidHide then
        task.defer(
            enterVoidHide
        )
    end

    return true
end

local function deleteConfig(name)
    name = tostring(
        name or State.ConfigName
    )

    if name == "Default" then
        return false
    end

    Runtime.Configs[name] = nil

    if State.ConfigName == name then
        State.ConfigName = "Default"
    end

    refreshConfigList()

    return true
end

local function disableAll()
    local wasVoidHide =
        State.VoidHide

    State.NormalTeleport = false
    State.VoidSpam = false
    State.RandomTeleport = false
    State.CustomTeleport = false
    State.Unpredictable = false
    State.FrameSkipper = false
    State.Orbit = false
    State.PhaseMatrix = false
    State.CycloneDrive = false
    State.RiftSurge = false
    State.VoidHide = false

    if wasVoidHide then
        exitVoidHide()
    end

    Runtime.UnpredictableBusy = false
    Runtime.RiftBusy = false
    Runtime.TeleportBusy = false
    Runtime.FrameCounter = 0
    Runtime.FrameSequence = 0
    Runtime.FrameBurstCounter = 0
    Runtime.FramePatternIndex = 0

    syncUI()
end

