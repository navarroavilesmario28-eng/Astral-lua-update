    end
end

local function nearestTarget()
    local root = getRoot()
    if not root then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            local character =
                player.Character

            local humanoid =
                character and
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local targetRoot =
                character and
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid and
                targetRoot and
                humanoid.Health > 0 then

                local distance =
                    (
                        targetRoot.Position -
                        root.Position
                    ).Magnitude

                if distance <
                    closestDistance then

                    closestDistance =
                        distance

                    closest =
                        targetRoot
                end
            end
        end
    end

    return closest
end

local function orbitStep(dt)
    local root = getRoot()
    if not root then
        return
    end

    local target = nearestTarget()
    if not target then
        return
    end

    local speed =
        math.max(
            1,
            safeNumber(
                State.OrbitSpeed,
                12
            )
        )

    Runtime.OrbitAngle +=
        dt *
        math.rad(
            speed * 30
        )

    local distance =
        clampDistance(
            State.OrbitDistance
        )

    local height =
        math.clamp(
            safeNumber(
                State.OrbitHeight,
                0
            ),
            -getMaxDistance(),
            getMaxDistance()
        )

    local offset =
        Vector3.new(
            math.cos(
                Runtime.OrbitAngle
            ) * distance,
            height,
            math.sin(
                Runtime.OrbitAngle
            ) * distance
        )

    teleport(
        target.Position +
        offset
    )
end

local function phaseStep()
    local root = getRoot()
    if not root then
        return
    end

    local target = nearestTarget()

    local direction

    if target then
        direction =
            unit(
                target.Position -
                root.Position,
                flatLook(root)
            )
    else
        direction =
            flatLook(root)
    end

    teleport(
        root.Position +
        direction *
        clampDistance(
            State.PhaseDistance
        )
    )
end

local function cycloneStep(dt)
    local root = getRoot()
    if not root then
        return
    end

    local target =
        nearestTarget()

    local center =
        target and
        target.Position or
        root.Position

    local speed =
        math.max(
            1,
            safeNumber(
                State.CycloneSpeed,
                10
            )
        )

    Runtime.CycloneAngle +=
        dt *
        math.rad(
            speed * 35
        )

    local distance =
        clampDistance(
            State.CycloneDistance
        )

    local vertical =
        math.sin(
            Runtime.CycloneAngle * 2
        ) *
        math.min(
            distance * 0.35,
            1000
        )

    teleport(
        center +
        Vector3.new(
            math.cos(
                Runtime.CycloneAngle
            ) * distance,
            vertical,
            math.sin(
                Runtime.CycloneAngle
            ) * distance
        )
    )
end

local function riftPoint(origin, index)
    local root = getRoot()
    if not root then
        return origin
    end

    local distance =
        clampDistance(
            State.RiftDistance
        )

    local height =
        math.clamp(
            safeNumber(
                State.RiftHeight,
                100
            ),
            -getMaxDistance(),
            getMaxDistance()
        )

    local steps =
        math.max(
            1,
            math.floor(
                safeNumber(
                    State.RiftSteps,
                    8
                )
            )
        )

    if State.RiftPattern == "Line" then
        return origin +
            flatLook(root) *
            distance *
            index
    end

    if State.RiftPattern == "Zigzag" then
        local forward =
            flatLook(root)

        local right =
            unit(
                root.CFrame.RightVector
            )

        local side =
            (
                index % 2 == 0
                and 1
                or -1
            ) *
            distance *
            0.45

        return origin +
            forward *
            distance *
            index +
            right * side +
            Vector3.new(
                0,
                math.sin(index) *
                height,
                0
            )
    end

    if State.RiftPattern == "Arc" then
        local progress =
            index / steps

        local angle =
            math.rad(
                safeNumber(
                    State.RiftSpread,
                    90
                )
            ) *
            progress

        local radius =
            distance * index

        return origin +
            Vector3.new(
                math.cos(angle) *
                radius,
                math.sin(angle) *
                height,
                math.sin(angle) *
                radius
            )
    end

    if State.RiftPattern == "Spiral" then
        local angle =
            index *
            math.rad(
                math.max(
                    10,
                    safeNumber(
                        State.RiftSpread,
                        90
                    )
                )
            )

        local radius =
            distance * index

        return origin +
            Vector3.new(
                math.cos(angle) *
                radius,
                math.sin(
                    index * 0.7
                ) * height,
                math.sin(angle) *
                radius
            )
    end

    return origin +
        spreadDirection(
            randomDirection(),
            State.RiftSpread
        ) *
        distance *
        index +
        Vector3.new(
            0,
            randomFloat(
                -height,
                height
            ),
            0
        )
end

local function riftDash()
    if Runtime.RiftBusy then
        return
    end

    Runtime.RiftBusy = true

    pcall(function()
        local root = getRoot()
        if not root then
            return
        end

        local origin =
            root.Position

        local points = {}

        local steps =
            math.clamp(
                math.floor(
                    safeNumber(
                        State.RiftSteps,
                        8
                    )
                ),
                1,
                50
            )

        for index = 1, steps do
            points[index] =
                riftPoint(
                    origin,
                    index
                )
        end

        local speed =
            math.max(
                1,
                safeNumber(
                    State.RiftSpeed,
                    18
                )
            )

        local delay =
            math.max(
                MIN_INTERVAL,
                1 / speed
            )

        if State.RiftReverse then
            for index = #points, 1, -1 do
                if not State.RiftSurge then
                    break
                end

                teleport(
                    points[index]
                )

                task.wait(
                    getTeleportInterval(
                        delay
                    )
                )
            end
        else
            for index = 1, #points do
                if not State.RiftSurge then
                    break
                end

                teleport(
                    points[index]
                )

                task.wait(
                    getTeleportInterval(
                        delay
                    )
                )
            end
        end

        if State.RiftReturn then
            teleport(origin)
        end
    end)

    Runtime.RiftBusy = false
end

local function copyState()
    local data = {}

    for key, value in pairs(State) do
        if typeof(value) ~= "table" then
            data[key] = value
        end
    end

    return data
end

local function refreshConfigList()
    local names = {}

    for name in pairs(Runtime.Configs) do
        table.insert(names, name)
    end

    if #names == 0 then
        names = {"Default"}
    end

    table.sort(names)

    if Runtime.Dropdowns.ConfigList then
        pcall(function()
            Runtime.Dropdowns.ConfigList:SetValues(
                names
            )
        end)

        pcall(function()
            Runtime.Dropdowns.ConfigList:SetValue(
                State.ConfigName
            )
        end)
    end
end

local function saveConfig(name)
    name = tostring(
        name or "Default"
    )

    if name:gsub("%s+", "") == "" then
        name = "Default"
    end

    State.ConfigName = name
    Runtime.Configs[name] =
        copyState()

    refreshConfigList()
end

