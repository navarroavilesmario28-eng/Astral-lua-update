local function safeNumber(value, fallback)
    value = tonumber(value)
    return value ~= nil and value or fallback
end

local function getRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return root, humanoid
end

local function getMaxDistance()
    return math.clamp(
        safeNumber(State.GlobalMaxDistance, MAX_DISTANCE),
        1,
        MAX_DISTANCE
    )
end

local function clampDistance(value)
    return math.clamp(
        math.abs(safeNumber(value, 0)),
        0,
        getMaxDistance()
    )
end

local function getInterval(value)
    return math.max(
        MIN_INTERVAL,
        safeNumber(value, 0.05)
    )
end

local function getTeleportInterval(value)
    local base = getInterval(value)
    local multiplier = math.clamp(
        safeNumber(State.SpeedMultiplier, 1),
        0.05,
        100
    )

    return math.max(
        MIN_INTERVAL,
        base / multiplier
    )
end

local function unit(vector, fallback)
    if typeof(vector) ~= "Vector3" or vector.Magnitude < 0.001 then
        return fallback or Vector3.new(0, 0, -1)
    end

    return vector.Unit
end

local function flatLook(root)
    return unit(
        Vector3.new(
            root.CFrame.LookVector.X,
            0,
            root.CFrame.LookVector.Z
        )
    )
end

local function randomDirection()
    local theta = math.random() * math.pi * 2
    local y = math.random() * 2 - 1
    local radius = math.sqrt(math.max(0, 1 - y * y))

    return Vector3.new(
        radius * math.cos(theta),
        y,
        radius * math.sin(theta)
    )
end

local function randomFloat(minimum, maximum)
    minimum = safeNumber(minimum, 0)
    maximum = safeNumber(maximum, 0)

    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end

    return minimum + math.random() * (maximum - minimum)
end

local function directionFrom(root, mode)
    if mode == "Look" then
        return unit(root.CFrame.LookVector)
    elseif mode == "Back" then
        return unit(-root.CFrame.LookVector)
    elseif mode == "Left" then
        return unit(-root.CFrame.RightVector)
    elseif mode == "Right" then
        return unit(root.CFrame.RightVector)
    elseif mode == "Up" then
        return Vector3.new(0, 1, 0)
    elseif mode == "Down" then
        return Vector3.new(0, -1, 0)
    end

    return flatLook(root)
end

local function spreadDirection(direction, degrees)
    direction = unit(direction)

    local spread = math.clamp(
        safeNumber(degrees, 0),
        0,
        180
    )

    if spread <= 0 then
        return direction
    end

    local random = randomDirection()
    local alpha = math.sin(math.rad(spread) / 2)

    return unit(
        direction:Lerp(random, alpha),
        direction
    )
end

local function rotateAroundY(direction, degrees)
    direction = unit(direction)

    local angle = math.rad(degrees)
    local c = math.cos(angle)
    local s = math.sin(angle)

    return unit(Vector3.new(
        direction.X * c - direction.Z * s,
        direction.Y,
        direction.X * s + direction.Z * c
    ), direction)
end

local function getRaycastParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    if LocalPlayer.Character then
        params.FilterDescendantsInstances = {
            LocalPlayer.Character
        }
    end

    return params
end

local function groundCorrect(position)
    if not State.GroundAssist then
        return position
    end

    local result = workspace:Raycast(
        position + Vector3.new(0, 1000, 0),
        Vector3.new(0, -2000, 0),
        getRaycastParams()
    )

    if result then
        return Vector3.new(
            position.X,
            result.Position.Y + 3,
            position.Z
        )
    end

    return position
end

local function collisionCorrect(position, root)
    if not State.CollisionSafe then
        return position
    end

    local size = root.Size + Vector3.new(0.5, 0.5, 0.5)

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {
        LocalPlayer.Character
    }

    local parts = workspace:GetPartBoundsInBox(
        CFrame.new(position),
        size,
        overlapParams
    )

    if #parts == 0 then
        return position
    end

    local result = workspace:Raycast(
        position + Vector3.new(0, 100, 0),
        Vector3.new(0, -200, 0),
        getRaycastParams()
    )

    if result then
        return result.Position + Vector3.new(0, 3, 0)
    end

    return position + Vector3.new(0, 4, 0)
end

local function validateDestination(position, root)
    if typeof(position) ~= "Vector3" then
        return root.Position
    end

    local offset = position - root.Position
    local magnitude = offset.Magnitude

    if magnitude > getMaxDistance() then
        position =
            root.Position +
            offset.Unit *
            getMaxDistance()
    end

    return position
end

local function getStyleValues()
    local style = State.EnhancerStyle

    if style == "Fast" then
        return 1.75, 1.15, 0.15
    elseif style == "Precision" then
        return 0.9, 1, 0
    elseif style == "Smooth" then
        return 0.8, 0.95, 0
    elseif style == "Aggressive" then
        return 3, 1.35, 0.35
    elseif style == "Dynamic" then
        return 1.5, 1.1, 0.2
    end

    return 1, 1, 0
end

local function enhancePosition(position, root)
    if not State.Enhancer then
        return position
    end

    local speedStyle, distanceStyle, randomStyle =
        getStyleValues()

    local requested = position - root.Position

    local distanceMultiplier =
        math.max(
            0.01,
            safeNumber(State.DistanceMultiplier, 1)
        )

    local power =
        math.max(
            0.01,
            safeNumber(State.TeleportPower, 1)
        )

    local totalDistanceMultiplier =
        distanceMultiplier *
        power *
        distanceStyle

    if requested.Magnitude > 0.001 then
        requested *= totalDistanceMultiplier
    end

    if State.AdaptiveDistance and
        requested.Magnitude >
        safeNumber(State.AdaptiveThreshold, 5000) then

        local threshold =
            math.max(
                1,
                safeNumber(
                    State.AdaptiveThreshold,
                    5000
                )
            )

        local adaptive =
            math.clamp(
                requested.Magnitude / threshold,
                1,
                math.max(
                    1,
                    safeNumber(
                        State.AdaptiveSteps,
                        4
                    )
                )
            )

        requested *=
            1 +
            ((adaptive - 1) * 0.15)
    end

    if requested.Magnitude >
        getMaxDistance() then

        requested =
            requested.Unit *
            getMaxDistance()
    end

    position =
        root.Position +
        requested

    local safeOffset =
        math.max(
            0,
            safeNumber(
                State.SafeOffset,
                0
            )
        )

    if safeOffset > 0 and
        requested.Magnitude > 0.001 then

        position +=
            requested.Unit *
            safeOffset
    end

    if State.MicroRandom then
        local amount =
            math.max(
                0,
                safeNumber(
                    State.MicroRandomAmount,
                    2
                )
            )

        position += Vector3.new(
            randomFloat(-amount, amount),
            randomFloat(-amount, amount),
            randomFloat(-amount, amount)
        )
    elseif randomStyle > 0 then
        local amount =
            safeNumber(
                State.MicroRandomAmount,
                2
            ) *
            randomStyle

        position += Vector3.new(
            randomFloat(-amount, amount),
            randomFloat(-amount, amount),
            randomFloat(-amount, amount)
        )
    end

    if State.AntiJitter and Runtime.LastDestination then
        local delta =
            position -
            Runtime.LastDestination

        local threshold =
            math.max(
                0,
                safeNumber(
                    State.JitterThreshold,
                    2
                )
            )

        if delta.Magnitude <= threshold then
            position =
                Runtime.LastDestination
        end
    end

    position =
        validateDestination(
            position,
            root
        )

    position =
        collisionCorrect(
            position,
            root
        )

    position =
        groundCorrect(
            position
        )

    position =
        validateDestination(
            position,
            root
        )

    return position
end

local function getFacingCFrame(root, position, originalRotation)
    local mode = State.FacingMode

    if mode == "Preserve" then
        return CFrame.new(position) * originalRotation
    end

    if mode == "Destination" then
        local direction =
            unit(
                position - root.Position,
                root.CFrame.LookVector
            )

        return CFrame.lookAt(
            position,
            position + direction
        )
    end

    if mode == "Movement" then
        local direction =
            unit(
                position - root.Position,
                root.CFrame.LookVector
            )

        return CFrame.lookAt(
            position,
            position + direction
        )
    end

    if mode == "Reverse" then
        local direction =
            unit(
                root.CFrame.LookVector
            )

        return CFrame.lookAt(
            position,
            position - direction
        )
    end

    return CFrame.new(position) * originalRotation
end

local function applyVelocity(root)
    if not State.ResetVelocity then
        return
    end

    local mode = State.VelocityMode

    if mode == "Reset" then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    elseif mode == "Soft" then
        root.AssemblyLinearVelocity *= 0.15
        root.AssemblyAngularVelocity *= 0.15
    elseif mode == "Preserve" then
        return
    elseif mode == "Forward" then
        root.AssemblyLinearVelocity =
            root.CFrame.LookVector *
            math.max(
                1,
                safeNumber(
                    State.TeleportPower,
                    1
                ) * 10
            )
    end
end

local function moveToPosition(root, position, rotation)
    local mode = State.SmoothMode

    if State.SmoothSnap then
        mode = "Stepped"
    end

    if mode == "Instant" then
        root.CFrame =
            getFacingCFrame(
                root,
                position,
                rotation
            )

        applyVelocity(root)
        return true
    end

    local start = root.Position

    local steps =
        math.clamp(
            math.floor(
                safeNumber(
                    State.SnapSteps,
                    3
                )
            ),
            1,
            30
        )

    if mode == "Smooth" then
        steps =
            math.max(
                steps * 2,
                4
            )
    end

    for i = 1, steps do
        if not getRoot() then
            return false
        end

        local alpha = i / steps

        if mode == "Smooth" then
            alpha =
                alpha *
                alpha *
                (3 - 2 * alpha)
        end

        local point =
            start:Lerp(
                position,
                alpha
            )

        root.CFrame =
            getFacingCFrame(
                root,
                point,
                rotation
            )

        applyVelocity(root)

        RunService.Heartbeat:Wait()
    end

    return true
end

local function performTeleport(position)
    if Runtime.TeleportBusy then
        return false
    end

    local root = getRoot()

    if not root then
        return false
    end

    local now = os.clock()

    local cooldown =
        math.max(
            0,
            safeNumber(
                State.TeleportCooldown,
                0
            )
        )

    if cooldown > 0 and
        now - Runtime.LastTeleport <
        cooldown then

        return false
    end

    local originalPosition =
        root.Position

    local originalRotation =
        root.CFrame - root.Position

    position =
        enhancePosition(
            position,
            root
        )

    if State.Recovery and
        Runtime.LastPosition and
        State.AntiJitter then

        if (
            position -
            Runtime.LastPosition
        ).Magnitude <
            math.max(
                0.01,
                safeNumber(
                    State.JitterThreshold,
                    2
                )
            ) then

            return false
        end
    end

    Runtime.TeleportBusy = true

    local success = false

    pcall(function()
        success =
            moveToPosition(
                root,
                position,
                originalRotation
            )
    end)

    Runtime.TeleportBusy = false

    if not success then
        return false
    end

    Runtime.LastPosition =
        originalPosition

    Runtime.LastDestination =
        position

    Runtime.LastDirection =
        unit(
            position - originalPosition,
            Runtime.LastDirection
        )

    Runtime.LastTeleport =
        os.clock()

    return true
end

local function teleport(position)
    local attempts =
        State.RetryTeleport
        and math.clamp(
            math.floor(
                safeNumber(
                    State.RetryCount,
                    3
                )
            ),
            1,
            10
        )
        or 1

    for _ = 1, attempts do
        if performTeleport(position) then
            return true
        end

        if State.Recovery then
            task.wait(MIN_INTERVAL)
        else
            break
        end
    end

    return false
end

local function normalStep()
    local root = getRoot()
    if not root then
        return
    end

    teleport(
        root.Position +
        directionFrom(
            root,
            State.NormalDirection
        ) *
        clampDistance(
            State.NormalDistance
        )
    )
end

local function randomStep()
    local root = getRoot()
    if not root then
        return
    end

    local minimum =
        clampDistance(
            State.RandomMin
        )

    local maximum =
        clampDistance(
            State.RandomMax
        )

    if maximum < minimum then
        minimum, maximum =
            maximum, minimum
    end

    local distance =
        randomFloat(
            minimum,
            maximum
        )

    local vertical =
        clampDistance(
            State.RandomVertical
        )

    teleport(
        root.Position +
        randomDirection() *
        distance +
        Vector3.new(
            0,
            randomFloat(
                -vertical,
                vertical
            ),
            0
        )
    )
end

local function customStep()
    local root = getRoot()
    if not root then
        return
    end

    teleport(
        root.Position +
        Vector3.new(
            math.clamp(
                safeNumber(
                    State.CustomX,
                    0
                ),
                -getMaxDistance(),
                getMaxDistance()
            ),
            math.clamp(
                safeNumber(
                    State.CustomY,
                    0
                ),
                -getMaxDistance(),
                getMaxDistance()
            ),
            math.clamp(
                safeNumber(
                    State.CustomZ,
                    0
                ),
                -getMaxDistance(),
                getMaxDistance()
            )
        )
    )
end

local function voidStep()
    local root = getRoot()
    if not root then
        return
    end

    local x =
        Vector3.new(
            clampDistance(State.VoidX),
            0,
            0
        )

    local y =
        Vector3.new(
            0,
            clampDistance(State.VoidY),
            0
        )

    local z =
        Vector3.new(
            0,
            0,
            clampDistance(State.VoidZ)
        )

    local offset

    if State.VoidAxis == "X" then
        offset = x
    elseif State.VoidAxis == "Y" then
        offset = y
    elseif State.VoidAxis == "Z" then
        offset = z
    else
        if Runtime.VoidAxisIndex == 1 then
            offset = x
        elseif Runtime.VoidAxisIndex == 2 then
            offset = y
        else
            offset = z
        end

        Runtime.VoidAxisIndex += 1

        if Runtime.VoidAxisIndex > 3 then
            Runtime.VoidAxisIndex = 1
        end
    end

    teleport(
        root.Position +
        offset
    )
end

local function getUnpredictableDirection(root, index)
    local mode =
        State.UnpredictableDirection

    if mode == "Look" then
        return spreadDirection(
            flatLook(root),
            State.UnpredictableSpread
        )
    end

    if mode == "Back" then
        return spreadDirection(
            -flatLook(root),
            State.UnpredictableSpread
        )
    end

    if mode == "Side" then
        local side =
            index % 2 == 0
            and root.CFrame.RightVector
            or -root.CFrame.RightVector

        return spreadDirection(
            side,
            State.UnpredictableSpread
        )
    end

    if mode == "Vertical" then
        return unit(
            Vector3.new(
                randomFloat(-0.35, 0.35),
                math.random(0, 1) == 0
                    and -1
                    or 1,
                randomFloat(-0.35, 0.35)
            )
        )
    end

    return spreadDirection(
        randomDirection(),
        State.UnpredictableSpread
    )
end

local function getUnpredictableDistance()
    local minimum =
        clampDistance(
            State.UnpredictableMin
        )

    local maximum =
        clampDistance(
            State.UnpredictableMax
        )

    if maximum < minimum then
        minimum, maximum =
            maximum, minimum
    end

    if State.UnpredictableDistanceMode == "Min" then
        return minimum
    elseif State.UnpredictableDistanceMode == "Max" then
        return maximum
    elseif State.UnpredictableDistanceMode == "Center" then
        return (minimum + maximum) / 2
    end

    return randomFloat(
        minimum,
        maximum
    )
end

local function getUnpredictableStyle(index)
    if State.UnpredictableStyle == "Calm" then
        local calm =
            math.clamp(
                safeNumber(
                    State.UnpredictableCalmness,
                    50
                ),
                0,
                100
            ) / 100

        return {
            DistanceScale =
                0.65 + calm * 0.35,
            Spread =
                math.min(
                    State.UnpredictableSpread,
                    35 + calm * 45
                ),
            VerticalScale =
                0.25 + calm * 0.35,
            DelayScale =
                1.5 - calm * 0.5
        }
    end

    if State.UnpredictableStyle == "Controlled" then
        return {
            DistanceScale = 0.85,
            Spread = 35,
            VerticalScale = 0.4,
            DelayScale = 1
        }
    end

    if State.UnpredictableStyle == "Wave" then
        local wave =
            math.sin(
                index * 0.9
            )

        return {
            DistanceScale =
                0.8 +
                math.abs(wave) * 0.5,
            Spread =
                25 +
                math.abs(wave) * 70,
            VerticalScale =
                0.5 +
                math.abs(wave) * 0.5,
            DelayScale =
                0.7 +
                math.abs(wave) * 0.8
        }
    end

    local chaos =
        math.clamp(
            safeNumber(
                State.UnpredictableChaos,
                75
            ),
            0,
            100
        ) / 100

    return {
        DistanceScale =
            0.7 + chaos * 0.9,
        Spread =
            math.min(
                180,
                State.UnpredictableSpread +
                chaos * 30
            ),
        VerticalScale =
            0.4 + chaos * 0.9,
        DelayScale =
            1.1 - chaos * 0.6
    }
end

local function unpredictableBurst()
    if Runtime.UnpredictableBusy then
        return
    end

    Runtime.UnpredictableBusy = true

    pcall(function()
        local count =
            math.clamp(
                math.floor(
                    safeNumber(
                        State.UnpredictableCount,
                        5
                    )
                ),
                1,
                100
            )

        local burst =
            math.clamp(
                math.floor(
                    safeNumber(
                        State.UnpredictableBurst,
                        2
                    )
                ),
                1,
                10
            )

        local previousDirection =
            Runtime.LastDirection

        for index = 1, count do
            if not State.Unpredictable then
                break
            end

            local root = getRoot()
            if not root then
                break
            end

            local style =
                getUnpredictableStyle(index)

            local distance =
                getUnpredictableDistance() *
                style.DistanceScale

            local direction =
                getUnpredictableDirection(
                    root,
                    index
                )

            if State.UnpredictablePattern ==
                "Alternating" then

                if previousDirection then
                    direction =
                        index % 2 == 0
                        and previousDirection
                        or -previousDirection
                end
            elseif State.UnpredictablePattern ==
                "Zigzag" then

                local side =
                    index % 2 == 0
                    and root.CFrame.RightVector
                    or -root.CFrame.RightVector

                direction =
                    unit(
                        flatLook(root) +
                        side * 0.8
                    )
            elseif State.UnpredictablePattern ==
                "Wave" then

                local angle =
                    math.sin(index * 0.8) *
                    State.UnpredictableSpread

                direction =
                    rotateAroundY(
                        flatLook(root),
                        angle
                    )
            elseif State.UnpredictablePattern ==
                "Burst" then

                direction =
                    spreadDirection(
                        direction,
                        style.Spread
                    )
            end

            direction =
                spreadDirection(
                    direction,
                    style.Spread
                )

            local vertical =
                clampDistance(
                    State.UnpredictableVertical
                ) *
                style.VerticalScale

            if State.UnpredictableHeightMode ==
                "Flat" then

                vertical = 0
            elseif State.UnpredictableHeightMode ==
                "High" then

                vertical =
                    math.abs(vertical)
            elseif State.UnpredictableHeightMode ==
                "Low" then

                vertical =
                    -math.abs(vertical)
            end

            if State.UnpredictableMomentum and
                previousDirection then

                direction =
                    unit(
                        direction +
                        previousDirection *
                        math.clamp(
                            safeNumber(
                                State.UnpredictableAcceleration,
                                1
                            ),
                            0,
                            10
                        ) *
                        0.1,
                        direction
                    )
            end

            local destination =
                root.Position +
                direction * distance +
                Vector3.new(
                    0,
                    randomFloat(
                        -vertical,
                        vertical
                    ),
                    0
                )

            teleport(destination)

            previousDirection =
                direction

            Runtime.UnpredictableSequence += 1

            if index % burst == 0 then
                task.wait(
                    getTeleportInterval(
                        State.UnpredictableDelay *
                        style.DelayScale
                    )
                )
            else
                task.wait(
                    MIN_INTERVAL
                )
            end
        end

        if State.UnpredictableReturn then
            local root = getRoot()
            if root and Runtime.LastPosition then
                teleport(
                    Runtime.LastPosition
                )
            end
        end
    end)

    Runtime.UnpredictableBusy = false
end

local function frameRandomStep()
    local root = getRoot()
    if not root then
        return
    end

    local minimum =
        clampDistance(
            State.FrameRandomMin
        )

    local maximum =
        clampDistance(
            State.FrameRandomMax
        )

    if maximum < minimum then
        minimum, maximum =
            maximum, minimum
    end

    local distance =
        randomFloat(
            minimum,
            maximum
        )

    local vertical =
        clampDistance(
            State.FrameRandomVertical
        )

    local direction =
        spreadDirection(
            flatLook(root),
            State.FrameRandomSpread
        )

    if State.FrameAdaptive then
        local velocity =
            root.AssemblyLinearVelocity.Magnitude

        local scale =
            1 +
            math.clamp(
                velocity / 100,
                0,
                10
            ) *
            safeNumber(
                State.FrameAdaptiveScale,
                1
            ) *
            0.1

        distance *= scale
    end

    local variance =
        math.max(
            0,
            safeNumber(
                State.FrameDistanceVariance,
                25
            )
        )

    distance +=
        randomFloat(
            -distance * variance / 100,
            distance * variance / 100
        )

    direction =
        rotateAroundY(
            direction,
            randomFloat(
                -State.FrameDirectionVariance,
                State.FrameDirectionVariance
            )
        )

    vertical +=
        randomFloat(
            -vertical *
                State.FrameVerticalVariance /
                100,
            vertical *
                State.FrameVerticalVariance /
                100
        )

    if math.random(1, 100) <=
        math.clamp(
            State.FrameReverseChance,
            0,
            100
        ) then

        direction = -direction
    end

    teleport(
        root.Position +
        direction * distance +
        Vector3.new(
            0,
            randomFloat(
                -vertical,
                vertical
            ),
            0
        )
    )
end

local function getFramePatternDirection(root, index)
    local forward =
        flatLook(root)

    local right =
        unit(root.CFrame.RightVector)

    local pattern =
        State.FramePattern

    if pattern == "Forward" then
        return forward
    end

    if pattern == "Backward" then
        return -forward
    end

    if pattern == "Left" then
        return -right
    end

    if pattern == "Right" then
        return right
    end

    if pattern == "Alternating" then
        return
            index % 2 == 0
            and -forward
            or forward
    end

    if pattern == "Zigzag" then
        return unit(
            forward +
            (
                index % 2 == 0
                and right
                or -right
            )
        )
    end

    if pattern == "Sideways" then
        return
            index % 2 == 0
            and right
            or -right
    end

    if pattern == "Circle" then
        local angle =
            index *
            math.rad(45)

        return unit(
            forward * math.cos(angle) +
            right * math.sin(angle)
        )
    end

    if pattern == "Random" then
        return spreadDirection(
            randomDirection(),
            State.FrameDirectionVariance
        )
    end

    return forward
end

local function frameStep()
    Runtime.FrameCounter += 1

    local skipped =
        math.clamp(
            math.floor(
                safeNumber(
                    State.SkippedFrames,
                    1
                )
            ),
            1,
            60
        )

    local phase =
        math.floor(
            safeNumber(
                State.FramePhaseOffset,
                0
            )
        )

    if (
        Runtime.FrameCounter +
        phase
    ) %
        (skipped + 1) ~= 0 then

        return
    end

    Runtime.FramePatternIndex += 1

    local burst =
        math.clamp(
            math.floor(
                safeNumber(
                    State.FrameBurst,
                    1
                )
            ),
            1,
            20
        )

    Runtime.FrameBurstCounter += 1

    if Runtime.FrameBurstCounter > burst then
        Runtime.FrameBurstCounter = 1
        return
    end

    if State.FrameMode == "Random" then
        frameRandomStep()
        return
    end

    local root = getRoot()
    if not root then
        return
    end

    local distance =
        clampDistance(
            State.SkipDistance
        )

    if State.FrameAdaptive then
        local velocity =
            root.AssemblyLinearVelocity.Magnitude

        distance *=
            1 +
            math.clamp(
                velocity / 100,
                0,
                10
            ) *
            safeNumber(
                State.FrameAdaptiveScale,
                1
            ) *
            0.1
    end

    local direction =
        getFramePatternDirection(
            root,
            Runtime.FramePatternIndex
        )

    if State.FramePattern == "Random" then
        direction =
            spreadDirection(
                direction,
                State.FrameDirectionVariance
            )
    end

    direction =
        rotateAroundY(
            direction,
            randomFloat(
                -State.FrameDirectionVariance,
                State.FrameDirectionVariance
            )
        )

    if math.random(1, 100) <=
        math.clamp(
            State.FrameReverseChance,
            0,
            100
        ) then

        direction = -direction
    end

    local vertical =
        clampDistance(
            State.FrameRandomVertical
        )

    vertical +=
        randomFloat(
            -vertical *
                State.FrameVerticalVariance /
                100,
            vertical *
                State.FrameVerticalVariance /
                100
        )

    local destination =
        root.Position +
        direction * distance +
        Vector3.new(
            0,
            randomFloat(
                -vertical,
                vertical
            ),
            0
        )

    teleport(destination)

    Runtime.LastFramePosition =
        destination

    if State.FrameChain and
        Runtime.FramePatternIndex %
        math.max(
            1,
            math.floor(
                State.FrameChainLength
            )
        ) == 0 then

        Runtime.FramePatternIndex = 0
    end
end

local function getVoidHidePosition(root)
    local distance =
        clampDistance(
            State.VoidHideDistance
        )

    local height =
        math.clamp(
            safeNumber(
                State.VoidHideHeight,
                0
            ),
            -getMaxDistance(),
            getMaxDistance()
        )

    local direction

    if State.VoidHidePreset == "Near" then
        direction = flatLook(root)
    elseif State.VoidHidePreset == "Far" then
        direction = -flatLook(root)
    elseif State.VoidHidePreset == "Far Corner" then
        direction =
            unit(
                -flatLook(root) +
                unit(root.CFrame.RightVector)
            )
    elseif State.VoidHidePreset == "Deep Void" then
        direction =
            unit(
                Vector3.new(
                    -flatLook(root).X,
                    -0.25,
                    -flatLook(root).Z
                )
            )
    elseif State.VoidHidePreset == "Extreme" then
        direction = randomDirection()
    else
        direction =
            Vector3.new(
                1,
                0,
                1
            ).Unit
    end

    return root.Position +
        direction * distance +
        Vector3.new(
            0,
            height,
            0
        )
end

local function enterVoidHide()
