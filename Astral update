local LastVoid = 0
local LastRandom = 0
local LastUnpredictable = 0
local LastSurge = 0

Connections.Main = RunService.Heartbeat:Connect(function(Delta)
    local Now = os.clock()

    if State.VoidSpam and Now - LastVoid >= State.VoidDelay then
        LastVoid = Now
        VoidSpamStep()
    end

    if State.RandomTeleport and Now - LastRandom >= State.VoidDelay then
        LastRandom = Now
        RandomTeleport()
    end

    if State.Unpredictable and Now - LastUnpredictable >= State.UnpredictableDelay then
        LastUnpredictable = Now
        task.spawn(UnpredictableTeleport)
    end

    if State.VoidHide then
        VoidHide()
    end

    if State.Orbit then
        OrbitStep(Delta)
    end

    if State.PhaseMatrix then
        PhaseStep(Delta)
    end

    if State.CycloneDrive then
        CycloneStep(Delta)
    end

    if State.RiftSurge and not State.SurgeBusy then
        if Now - LastSurge >= math.max(State.SurgeSpeed, 0.01) then
            LastSurge = Now
            task.spawn(RiftSurgeOnce)
        end
    end
end)

Connections.Render = RunService.RenderStepped:Connect(function()
    if not State.FrameSkipper then
        State.FrameSkipCounter = 0
        return
    end

    State.FrameSkipCounter += 1

    if State.FrameSkipCounter >= math.clamp(
        math.floor(State.FrameSkipFrames),
        1,
        MAX_FRAMES
    ) then
        State.FrameSkipCounter = 0
        FrameSkipStep()
    end
end)

Connections.Character = LocalPlayer.CharacterAdded:Connect(function()
    State.VoidIndex = 1
    State.VoidHideOrigin = nil
    State.VoidHidePosition = nil
    State.OrbitAngle = 0
    State.CycloneAngle = 0
end)

