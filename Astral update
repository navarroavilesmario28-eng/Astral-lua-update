local function GetRoot()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or Humanoid.Health <= 0 or not Root then
        return nil
    end

    return Root
end

local function Teleport(Position)
    local Root = GetRoot()
    if not Root then
        return false
    end

    Root.CFrame = CFrame.new(Position) * Root.CFrame.Rotation
    return true
end

local function ClampDistance(Value)
    return math.clamp(Value, -MAX_DISTANCE, MAX_DISTANCE)
end

local function GetPresetDistance()
    if State.VoidHidePreset == "Near" then
        return 500
    elseif State.VoidHidePreset == "Far" then
        return 100000
    elseif State.VoidHidePreset == "Far Corner" then
        return 1000000
    elseif State.VoidHidePreset == "Deep Void" then
        return 10000000
    elseif State.VoidHidePreset == "Extreme" then
        return MAX_DISTANCE
    end

    return State.VoidHideDistance
end

local function NormalTeleport()
    local Root = GetRoot()
    if not Root then
        return
    end

    Teleport(
        Root.Position +
        Root.CFrame.LookVector * ClampDistance(State.NormalDistance)
    )
end

local function RandomTeleport()
    local Root = GetRoot()
    if not Root then
        return
    end

    local Min = math.min(State.RandomMin, State.RandomMax)
    local Max = math.max(State.RandomMin, State.RandomMax)

    local Distance = Min + math.random() * (Max - Min)
    local Angle = math.rad(math.random(0, 359))

    local Direction = Vector3.new(
        math.cos(Angle),
        0,
        math.sin(Angle)
    )

    local Vertical = math.random(
        -math.abs(State.RandomVertical),
        math.abs(State.RandomVertical)
    )

    Teleport(
        Root.Position +
        Direction * Distance +
        Vector3.new(0, Vertical, 0)
    )
end

local function CustomTeleport()
    local Root = GetRoot()
    if not Root then
        return
    end

    local Offset = Vector3.new(
        ClampDistance(State.CustomX),
        ClampDistance(State.CustomY),
        ClampDistance(State.CustomZ)
    )

    Teleport(Root.Position + Offset)
end

local function VoidSpamStep()
    local Root = GetRoot()
    if not Root then
        return
    end

    local Axis

    if State.VoidAxis == "X → Y → Z" then
        Axis = State.VoidIndex

        State.VoidIndex += 1

        if State.VoidIndex > 3 then
            State.VoidIndex = 1
        end
    elseif State.VoidAxis == "X Only" then
        Axis = 1
    elseif State.VoidAxis == "Y Only" then
        Axis = 2
    else
        Axis = 3
    end

    local Offset

    if Axis == 1 then
        Offset = Vector3.new(State.VoidX, 0, 0)
    elseif Axis == 2 then
        Offset = Vector3.new(0, State.VoidY, 0)
    else
        Offset = Vector3.new(0, 0, State.VoidZ)
    end

    Teleport(Root.Position + Offset)
end

local function UnpredictableTeleport()
    local Root = GetRoot()
    if not Root then
        return
    end

    local Count = math.max(1, math.floor(State.UnpredictableCount))

    for _ = 1, Count do
        Root = GetRoot()
        if not Root then
            break
        end

        local Min = math.min(
            State.UnpredictableMin,
            State.UnpredictableMax
        )

        local Max = math.max(
            State.UnpredictableMin,
            State.UnpredictableMax
        )

        local Distance = Min + math.random() * (Max - Min)
        local Angle = math.rad(
            math.random() * State.UnpredictableSpread
        )

        local Direction = Vector3.new(
            math.cos(Angle),
            0,
            math.sin(Angle)
        )

        local Height = math.random(
            -math.abs(State.UnpredictableVertical),
            math.abs(State.UnpredictableVertical)
        )

        Teleport(
            Root.Position +
            Direction * Distance +
            Vector3.new(0, Height, 0)
        )

        task.wait(State.UnpredictableDelay)
    end
end

local function FrameSkipStep()
    local Root = GetRoot()
    if not Root then
        return
    end

    local Direction = Root.CFrame.LookVector

    if State.FrameSkipDirection == "Backward" then
        Direction = -Root.CFrame.LookVector
    elseif State.FrameSkipDirection == "Left" then
        Direction = -Root.CFrame.RightVector
    elseif State.FrameSkipDirection == "Right" then
        Direction = Root.CFrame.RightVector
    elseif State.FrameSkipDirection == "Up" then
        Direction = Vector3.yAxis
    elseif State.FrameSkipDirection == "Down" then
        Direction = -Vector3.yAxis
    end

    Teleport(
        Root.Position +
        Direction * ClampDistance(State.FrameSkipDistance)
    )
end

local function VoidHide()
    local Root = GetRoot()
    if not Root then
        return
    end

    if not State.VoidHide then
        return
    end

    if not State.VoidHidePosition then
        State.VoidHideOrigin = Root.CFrame

        local Distance = GetPresetDistance()
        local Direction = (
            Root.CFrame.LookVector +
            Root.CFrame.RightVector
        ).Unit

        State.VoidHidePosition =
            Root.Position +
            Direction * Distance +
            Vector3.new(0, Distance, 0)
    end

    Root.CFrame =
        CFrame.new(State.VoidHidePosition) *
        Root.CFrame.Rotation

    if State.VoidHideFloating then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function ExitVoidHide()
    if not State.VoidHideOrigin then
        State.VoidHidePosition = nil
        return
    end

    if State.VoidHideReturn then
        local Root = GetRoot()
        if Root then
            Root.CFrame = State.VoidHideOrigin
        end
    end

    State.VoidHideOrigin = nil
    State.VoidHidePosition = nil
end

local function FindNearestPlayer()
    local Root = GetRoot()
    if not Root then
        return nil
    end

    local Nearest
    local Distance = math.huge

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            local TargetRoot = Character and Character:FindFirstChild("HumanoidRootPart")

            if Humanoid and TargetRoot and Humanoid.Health > 0 then
                local CurrentDistance =
                    (TargetRoot.Position - Root.Position).Magnitude

                if CurrentDistance < Distance then
                    Distance = CurrentDistance
                    Nearest = TargetRoot
                end
            end
        end
    end

    return Nearest
end

local function OrbitStep(Delta)
    local Root = GetRoot()
    if not Root then
        return
    end

    OrbitTarget = FindNearestPlayer()

    if not OrbitTarget then
        return
    end

    State.OrbitAngle += State.OrbitSpeed * Delta

    local Angle = State.OrbitAngle
    local Distance = math.abs(State.OrbitDistance)

    local Position =
        OrbitTarget.Position +
        Vector3.new(
            math.cos(Angle) * Distance,
            State.OrbitHeight,
            math.sin(Angle) * Distance
        )

    Teleport(Position)
end

local function PhaseStep(Delta)
    local Root = GetRoot()
    if not Root then
        return
    end

    State.PhaseSize = math.clamp(
        State.PhaseSize,
        0,
        MAX_DISTANCE
    )

    local Offset =
        Root.CFrame.LookVector *
        math.sin(os.clock() * State.PhaseSpeed) *
        State.PhaseSize

    Teleport(Root.Position + Offset)
end

local function CycloneStep(Delta)
    local Root = GetRoot()
    if not Root then
        return
    end

    State.CycloneAngle += State.CycloneSpeed * Delta

    local Radius = math.abs(State.CycloneDistance)

    local Position =
        Root.Position +
        Vector3.new(
            math.cos(State.CycloneAngle) * Radius,
            math.sin(State.CycloneAngle * 1.5) * Radius * 0.25,
            math.sin(State.CycloneAngle) * Radius
        )

    Teleport(Position)
end

local function RiftPoint(Root, Index, Total)
    local Pattern = State.SurgePattern
    local T = Total <= 1 and 1 or (Index - 1) / (Total - 1)

    local Forward = Root.CFrame.LookVector
    local Right = Root.CFrame.RightVector
    local Up = Vector3.yAxis

    local Distance = State.SurgeDistance
    local Spread = State.SurgeSpread
    local Height = State.SurgeHeight

    if Pattern == "Line" then
        return Root.Position + Forward * Distance * T

    elseif Pattern == "Zigzag" then
        local Side = (Index % 2 == 0 and 1 or -1) * Spread

        return Root.Position +
            Forward * Distance * T +
            Right * Side +
            Up * Height * T

    elseif Pattern == "Arc" then
        local Angle = math.rad(-90 + 180 * T)

        return Root.Position +
            Forward * math.cos(Angle) * Distance +
            Right * math.sin(Angle) * Spread +
            Up * Height * math.sin(math.pi * T)

    elseif Pattern == "Spiral" then
        local Angle = T * math.pi * 4

        return Root.Position +
            Forward * math.cos(Angle) * Distance * T +
            Right * math.sin(Angle) * Distance * T +
            Up * Height * T

    elseif Pattern == "Random" then
        local Angle = math.random() * math.pi * 2
        local Radius = math.random() * math.abs(Spread)

        return Root.Position +
            Forward * Distance * T +
            Right * math.cos(Angle) * Radius +
            Up * math.sin(Angle) * Radius

    end

    return Root.Position + Forward * Distance * T
end

local function RiftSurgeOnce()
    if State.SurgeBusy then
        return
    end

    State.SurgeBusy = true

    local Root = GetRoot()

    if Root then
        local Origin = Root.CFrame
        local Steps = math.max(1, math.floor(State.SurgeSteps))

        for Step = 1, Steps do
            Root = GetRoot()

            if not Root then
                break
            end

            local Index = Step

            if State.SurgeReverse then
                Index = Steps - Step + 1
            end

            local Position = RiftPoint(
                Origin,
                Index,
                Steps
            )

            Teleport(Position)

            task.wait(
                math.max(
                    0,
                    State.SurgeSpeed
                )
            )
        end
    end

    State.SurgeBusy = false
end

